generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATRON
  LIBRARIAN
}

model User {
  id        Int      @id @default(autoincrement()) // primary key
  email     String   @unique                       // unique login email
  name      String                                 // user's full name
  password  String                                 // bcrypt hashed password (never plain text!)
  role      Role     @default(PATRON)              // PATRON or LIBRARIAN
  createdAt DateTime @default(now())               // creation timestamp
  reviews   Review[]                               // reviews written by this user
}

model Genre {
  id    Int    @id @default(autoincrement())
  name  String @unique // unique genre name, e.g., "Fiction"
  books Book[]         // one genre has many books
}

model Book {
  id            Int      @id @default(autoincrement())
  title         String
  author        String
  isbn          String   @unique                       // unique ISBN identifier
  totalCopies   Int      @default(1)                   // total copies in library catalog
  publishedYear Int?                                   // optional published year

  genreId       Int                                    // foreign key to Genre
  genre         Genre    @relation(fields: [genreId], references: [id])
  reviews       Review[]                               // reviews for this book

  @@index([genreId])                                   // database index for faster lookups
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int                                    // rating from 1 to 5
  comment   String?                                // optional feedback text
  createdAt DateTime @default(now())

  bookId    Int                                    // foreign key to Book
  userId    Int                                    // foreign key to User
  book      Book     @relation(fields: [bookId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([bookId, userId])                       // one review per user per book
}
