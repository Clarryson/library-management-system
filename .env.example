# Environment variables template
# Copy this file to .env and replace the placeholder values with your actual database credentials.
# DO NOT commit actual passwords or secret credentials to Git!

# PostgreSQL connection string:
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/library_db?schema=public"

# JWT Secret key used to sign and verify authentication tokens:
JWT_SECRET="your-super-secret-jwt-key-replace-in-production"

# Server Port:
PORT=3000
